@startuml
title Casos de uso del actor Tesista

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor Tesista

rectangle "Sistema Karify" {

  package "Autenticación y perfil" {
    usecase "CU-001\nIniciar sesión con\ncuenta institucional" as TES01
    usecase "CU-002\nConfigurar perfil" as TES02
  }

  package "Gestión de proyectos" {
    usecase "CU-003\nRegistrar proyecto" as TES03
    usecase "CU-004\nEditar proyecto" as TES04
    usecase "CU-005\nConsultar proyectos\nregistrados" as TES05
    usecase "CU-017\nCancelar proyecto" as TES17
  }

  package "Resultados y constancias" {
    usecase "CU-008\nConsultar resultado\nde similitud" as TES08
    usecase "CU-009\nConsultar y descargar\nconstancia" as TES09
  }
}

Tesista --> TES01
Tesista --> TES02
Tesista --> TES03
Tesista --> TES04
Tesista --> TES05
Tesista --> TES17
Tesista --> TES08
Tesista --> TES09

TES02 .> TES01 : <<extend>>\n[perfil incompleto]
TES04 .> TES05 : <<extend>>\n[estado editable]
TES17 .> TES05 : <<extend>>\n[antes de revisión docente]
TES08 .> TES05 : <<extend>>\n[procesamiento finalizado]
TES09 .> TES05 : <<extend>>\n[constancia disponible]

note right of TES03
El registro incluye como parte del mismo objetivo:
- documento obligatorio;
- selección del docente asesor;
- selección de cotesista, cuando corresponda.
end note

note right of TES17
La cancelación solo está disponible
antes de que el proyecto llegue
a la bandeja del docente asesor.
end note

note right of TES08
El porcentaje de similitud es un apoyo
para la revisión académica.
No determina por sí solo plagio,
duplicidad u originalidad.
end note

@enduml
